---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getReadTime } from '../utils/readTime';
import type { BreadcrumbItem, WebPageType } from '../lib/structured-data';

type Props = CollectionEntry<'blog'>['data'] & {
	body?: string;
	breadcrumbs?: BreadcrumbItem[];
	jsonLd?: Record<string, unknown>[];
	webPageType?: WebPageType;
	mainEntityId?: string;
	datePublished?: Date;
	dateModified?: Date;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	body,
	breadcrumbs,
	jsonLd,
	webPageType,
	mainEntityId,
	datePublished,
	dateModified,
} = Astro.props;
const readTime = body ? getReadTime(body) : null;

// Fall back to the content's own pubDate/updatedDate when explicit schema
// dates aren't passed, so any page using this layout (e.g. about.mdx, which
// sets pubDate) still carries datePublished/dateModified into the schema.
const resolvedDatePublished = datePublished ?? pubDate;
const resolvedDateModified = dateModified ?? updatedDate ?? pubDate;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      breadcrumbs={breadcrumbs}
      jsonLd={jsonLd}
      webPageType={webPageType}
      mainEntityId={mainEntityId}
      datePublished={resolvedDatePublished}
      dateModified={resolvedDateModified}
    />
  </head>

  <body>
    <Header />
    <main id="content" class="post-main" tabindex="-1">
      {heroImage && (
        <div class="hero-image">
          <Image width={1020} height={510} src={heroImage} alt="" loading="eager" decoding="async" />
        </div>
      )}
      <article>
        <div class="post-header">
          <h1>{title}</h1>
          <p class="post-meta">
            <span><FormattedDate date={pubDate} /></span>
            {readTime && (
              <>
                <span class="meta-separator">·</span>
                <span>{readTime}</span>
              </>
            )}
          </p>
          {updatedDate && (
            <p class="last-updated-on">
              Last updated on <FormattedDate date={updatedDate} />
            </p>
          )}
        </div>
        <slot />
      </article>
    </main>
    <Footer />
  </body>
</html>
