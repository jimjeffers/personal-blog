---
import { THEMES } from '../data/themes';

const darkThemes = THEMES.filter(t => t.mode === 'dark');
const lightThemes = THEMES.filter(t => t.mode === 'light');
---

<div class="theme-selector">
  <button
    type="button"
    class="theme-trigger"
    aria-expanded="false"
    aria-controls="theme-options"
  >
    <span class="trigger-label">Theme</span>
    <span class="trigger-name">Theme</span>
    <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
  <div class="theme-dropdown" id="theme-options" hidden>
    <div class="theme-columns">
      <div class="theme-column">
        <p class="column-header" id="dark-themes">Dark</p>
        <ul class="theme-list" aria-labelledby="dark-themes">
          {darkThemes.map((theme) => (
            <li>
              <button
                type="button"
                class="theme-option"
                data-theme-id={theme.id}
                data-bg={theme.bg}
                data-text={theme.text}
                data-text-secondary={theme.textSecondary}
                data-accent={theme.accent}
                data-accent-hex={theme.accentHex}
                data-border={theme.border}
                data-header-weight={theme.headerWeight}
                data-bg-hex={theme.bgHex}
                data-mode={theme.mode}
                aria-pressed="false"
              >
                <span class="option-name">{theme.name}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="theme-column">
        <p class="column-header" id="light-themes">Light</p>
        <ul class="theme-list" aria-labelledby="light-themes">
          {lightThemes.map((theme) => (
            <li>
              <button
                type="button"
                class="theme-option"
                data-theme-id={theme.id}
                data-bg={theme.bg}
                data-text={theme.text}
                data-text-secondary={theme.textSecondary}
                data-accent={theme.accent}
                data-accent-hex={theme.accentHex}
                data-border={theme.border}
                data-header-weight={theme.headerWeight}
                data-bg-hex={theme.bgHex}
                data-mode={theme.mode}
                aria-pressed="false"
              >
                <span class="option-name">{theme.name}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  .theme-selector {
    position: relative;
  }

  .theme-trigger {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    background: none;
    border: none;
    color: rgb(var(--color-text-secondary));
    cursor: pointer;
    padding: 0;
    font-family: inherit;
    font-size: 0.65rem;
    line-height: 1;
    transition: color 0.15s ease;
  }

  .theme-trigger:hover {
    color: rgb(var(--color-text));
  }

  .trigger-label::after {
    content: ':';
  }

  .chevron {
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .theme-trigger[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
  }

  .theme-dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 200;
    background-color: rgb(var(--color-bg));
    border: 1px solid rgb(var(--color-text) / 0.1);
    border-radius: 0.5rem;
    padding: 0.5rem;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.15);
  }

  .theme-dropdown[hidden] {
    display: none;
  }

  .theme-columns {
    display: flex;
    gap: 0.5rem;
  }

  .theme-column {
    display: flex;
    flex-direction: column;
  }

  .column-header {
    font-size: 0.65rem;
    font-weight: 600;
    color: rgb(var(--color-text-secondary));
    padding: 0.375rem 0.5rem;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .theme-list {
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 7rem;
  }

  .theme-option {
    display: flex;
    align-items: center;
    width: 100%;
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0.4rem 0.5rem;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    text-align: left;
    color: rgb(var(--color-text));
    transition: background-color 0.15s ease, color 0.15s ease;
    border-radius: 0.25rem;
  }

  .theme-option:hover {
    /* Theme colors applied via JS on hover */
  }

  .theme-option.active {
    box-shadow: inset 0 0 0 1px rgb(var(--color-accent) / 0.7);
  }

  .option-name {
    white-space: nowrap;
  }
</style>
