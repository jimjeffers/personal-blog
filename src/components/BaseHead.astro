---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { STORAGE_KEY, THEMES } from '../data/themes';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
const pageTitle = title === SITE_TITLE ? `${SITE_TITLE} | Blog` : `${title} | ${SITE_TITLE}`;
const themeMap = Object.fromEntries(
	THEMES.map((theme) => [
		theme.id,
		[
			theme.bg,
			theme.text,
			theme.textSecondary,
			theme.accent,
			theme.border,
			theme.headerWeight,
			theme.mode,
		],
	]),
);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<script define:vars={{ themeMap, storageKey: STORAGE_KEY }}>
(function() {
  var T = themeMap;
  var id;
  try { id = localStorage.getItem(storageKey); } catch(e) {}
  if (!id || !T[id]) {
    var prefersDark = false;
    try {
      prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    } catch(e) {}
    id = prefersDark ? 'catppuccin' : 'flexoki-light';
  }
  var v = T[id];
  var d = document.documentElement;
  d.setAttribute('data-theme', id);
  d.style.setProperty('--color-bg', v[0]);
  d.style.setProperty('--color-text', v[1]);
  d.style.setProperty('--color-text-secondary', v[2]);
  d.style.setProperty('--color-accent', v[3]);
  d.style.setProperty('--color-border', v[4]);
  d.style.setProperty('--header-weight', v[5]);
  d.style.setProperty('--color-scheme', v[6]);
})();
</script>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />

<script define:vars={{ storageKey: STORAGE_KEY }}>
(function() {
  function initThemeSelector() {
    var selector = document.querySelector('.theme-selector');
    if (!selector || selector.dataset.initialized === 'true') return;
    selector.dataset.initialized = 'true';

    var trigger = selector.querySelector('.theme-trigger');
    var dropdown = selector.querySelector('.theme-dropdown');
    var options = selector.querySelectorAll('.theme-option');
    var triggerName = trigger && trigger.querySelector('.trigger-name');
    if (!trigger || !dropdown || !triggerName) return;

    var activeThemeId = document.documentElement.getAttribute('data-theme') || '';

    function setThemeProperties(option) {
      var id = option.getAttribute('data-theme-id');
      var bg = option.getAttribute('data-bg');
      var text = option.getAttribute('data-text');
      var textSecondary = option.getAttribute('data-text-secondary');
      var accent = option.getAttribute('data-accent');
      var border = option.getAttribute('data-border');
      var headerWeight = option.getAttribute('data-header-weight');
      var mode = option.getAttribute('data-mode');
      if (!id || !bg || !text || !textSecondary || !accent || !border || !headerWeight || !mode) return activeThemeId;

      var d = document.documentElement;
      d.setAttribute('data-theme', id);
      d.style.setProperty('--color-bg', bg);
      d.style.setProperty('--color-text', text);
      d.style.setProperty('--color-text-secondary', textSecondary);
      d.style.setProperty('--color-accent', accent);
      d.style.setProperty('--color-border', border);
      d.style.setProperty('--header-weight', headerWeight);
      d.style.setProperty('--color-scheme', mode);

      return id;
    }

    function updateDisplay(option) {
      var name = option.querySelector('.option-name');
      triggerName.textContent = name ? name.textContent || 'Theme' : 'Theme';
    }

    function updateSelected(active) {
      options.forEach(function(option) {
        var isActive = option === active;
        option.classList.toggle('active', isActive);
        option.setAttribute('aria-pressed', String(isActive));
      });
    }

    function close() {
      dropdown.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    }

    function open() {
      dropdown.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
    }

    function applyTheme(option) {
      var id = setThemeProperties(option);
      activeThemeId = id;
      try { localStorage.setItem(storageKey, id); } catch(e) {}
      updateDisplay(option);
      updateSelected(option);
      document.dispatchEvent(new CustomEvent('themechange'));
      close();
      trigger.focus();
    }

    function initDisplay() {
      var currentId = document.documentElement.getAttribute('data-theme');
      if (!currentId) return;
      activeThemeId = currentId;
      var active = selector.querySelector('[data-theme-id="' + currentId + '"]');
      if (active) {
        updateDisplay(active);
        updateSelected(active);
      }
    }

    trigger.addEventListener('click', function(event) {
      event.stopPropagation();
      if (dropdown.hidden) {
        open();
        var active = selector.querySelector('[data-theme-id="' + activeThemeId + '"]');
        if (active) active.focus();
        return;
      }
      close();
    });

    options.forEach(function(option) {
      option.addEventListener('click', function() { applyTheme(option); });
      option.addEventListener('mouseenter', function() {
        var bgHex = option.getAttribute('data-bg-hex');
        var accentHex = option.getAttribute('data-accent-hex');
        if (bgHex && accentHex) {
          option.style.backgroundColor = bgHex;
          option.style.color = accentHex;
        }
      });
      option.addEventListener('mouseleave', function() {
        option.style.backgroundColor = '';
        option.style.color = '';
      });
    });

    document.addEventListener('click', function(event) {
      if (!selector.contains(event.target)) close();
    });

    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        close();
        trigger.focus();
      }
    });

    initDisplay();
  }

  function initGitHubChart() {
    var chart = document.getElementById('github-chart');
    if (!chart || chart.dataset.initialized === 'true') return;
    var username = chart.getAttribute('data-github-username');
    if (!username) return;
    chart.dataset.initialized = 'true';

    function getCurrentAccentHex() {
      var currentThemeId = document.documentElement.getAttribute('data-theme');
      if (currentThemeId) {
        var themeOption = document.querySelector('[data-theme-id="' + currentThemeId + '"]');
        var accent = themeOption && themeOption.getAttribute('data-accent-hex');
        if (accent) return accent.replace('#', '');
      }

      var activeTheme = document.querySelector('.theme-option.active');
      var activeAccent = activeTheme && activeTheme.getAttribute('data-accent-hex');
      return activeAccent ? activeAccent.replace('#', '') : '89b4fa';
    }

    function updateChartColor() {
      var accentHex = getCurrentAccentHex();
      var newSrc = 'https://ghchart.rshah.org/' + accentHex + '/' + username;
      if (chart.src !== newSrc) chart.src = newSrc;
    }

    chart.addEventListener('error', function() {
      chart.src = 'https://ghchart.rshah.org/' + username;
    });

    updateChartColor();
    document.addEventListener('themechange', updateChartColor);
  }

  function initEnhancements() {
    initThemeSelector();
    initGitHubChart();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEnhancements, { once: true });
  } else {
    initEnhancements();
  }
  document.addEventListener('astro:after-swap', initEnhancements);
})();
</script>
